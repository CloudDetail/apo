{
  "id": "",
  "name": "Redis 指标",
  "description": "从 Grafana 面板迁移并汉化，已转换为“我的面板”原生格式。来源：redis。",
  "ownerId": 0,
  "creator": "",
  "visibility": "everyone",
  "teamIds": [],
  "variables": [
    {
      "name": "cluster_id",
      "label": "集群",
      "type": "cluster",
      "value": ".*",
      "multi": true,
      "required": false,
      "defaultValue": ".*",
      "includeAll": true,
      "allValue": ".*",
      "query": "SELECT DISTINCT scope_id AS __value, \nCASE \n  WHEN c.name != '' THEN c.name\n  ELSE scope_id\nEND AS __text\nFROM data_scope \nLEFT JOIN clusters c ON scope_id  = c.id\nWHERE type = 'cluster'",
      "labels": [
        "cluster",
        "cluster_id",
        "clusterId",
        "clusterID",
        "cluster_name"
      ]
    },
    {
      "name": "vendor",
      "label": "云厂商",
      "type": "label",
      "value": "None",
      "multi": false,
      "required": false,
      "defaultValue": "None",
      "query": "label_values(redis_up{cluster_id=~\"$cluster_id\"}, vendor)",
      "labels": [
        "vendor"
      ]
    },
    {
      "name": "account",
      "label": "账号",
      "type": "label",
      "value": "None",
      "multi": false,
      "required": false,
      "defaultValue": "None",
      "query": "label_values(redis_up{vendor=~\"$vendor\", cluster_id=~\"$cluster_id\"}, account)",
      "labels": [
        "account"
      ]
    },
    {
      "name": "group",
      "label": "属组",
      "type": "label",
      "value": ".*",
      "multi": false,
      "required": false,
      "defaultValue": ".*",
      "includeAll": true,
      "allValue": ".*",
      "query": "label_values(redis_up{vendor=~\"$vendor\",account=~\"$account\", cluster_id=~\"$cluster_id\"}, group)",
      "labels": [
        "group"
      ]
    },
    {
      "name": "name",
      "label": "名称",
      "type": "label",
      "value": ".*",
      "multi": false,
      "required": false,
      "defaultValue": ".*",
      "includeAll": true,
      "allValue": ".*",
      "query": "label_values(redis_up{vendor=~\"$vendor\",account=~\"$account\",group=~\"$group\", cluster_id=~\"$cluster_id\"}, name)",
      "labels": [
        "name"
      ]
    },
    {
      "name": "instance",
      "label": "实例",
      "type": "instance",
      "value": ".*",
      "multi": true,
      "required": false,
      "defaultValue": ".*",
      "includeAll": true,
      "allValue": ".*",
      "query": "label_values(redis_up{vendor=~\"$vendor\",account=~\"$account\",group=~\"$group\",name=~\"$name\", cluster_id=~\"$cluster_id\"}, instance)",
      "labels": [
        "instance",
        "instance_name",
        "node_name",
        "nodeName",
        "host_name",
        "hostName"
      ]
    },
    {
      "name": "iid",
      "label": "实例 ID",
      "type": "label",
      "value": "None",
      "multi": false,
      "required": false,
      "defaultValue": "None",
      "query": "label_values(redis_up{vendor=~\"$vendor\",account=~\"$account\",group=~\"$group\",name=~\"$name\", cluster_id=~\"$cluster_id\"}, iid)",
      "labels": [
        "iid"
      ]
    }
  ],
  "widgets": [
    {
      "id": "grafana-35",
      "title": "REDIS资源总览表【$vendor：$account：$group】",
      "description": "REDIS资源总览表【$vendor：$account：$group】。",
      "type": "table",
      "layout": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 1
      },
      "query": {
        "mode": "custom",
        "presetId": "",
        "expression": "redis_up{account=~\"${account:regex}\",group=~\"${group:regex}\", cluster_id=~\"${cluster_id:regex}\"}",
        "params": {},
        "legend": "__auto",
        "queries": [
          {
            "id": "A",
            "expression": "redis_up{account=~\"${account:regex}\",group=~\"${group:regex}\", cluster_id=~\"${cluster_id:regex}\"}",
            "legend": "__auto"
          },
          {
            "id": "D",
            "expression": "sum(redis_connected_clients{account=~\"${account:regex}\",group=~\"${group:regex}\", cluster_id=~\"${cluster_id:regex}\"})by(instance)",
            "legend": "__auto"
          },
          {
            "id": "E",
            "expression": "sum(irate(redis_commands_total{account=~\"${account:regex}\",group=~\"${group:regex}\", cluster_id=~\"${cluster_id:regex}\"} [2m]))by(instance)",
            "legend": "__auto"
          },
          {
            "id": "F",
            "expression": "redis_uptime_in_seconds{account=~\"${account:regex}\",group=~\"${group:regex}\", cluster_id=~\"${cluster_id:regex}\"} - 0",
            "legend": "__auto"
          },
          {
            "id": "G",
            "expression": "avg(irate(redis_keyspace_hits_total{account=~\"${account:regex}\",group=~\"${group:regex}\", cluster_id=~\"${cluster_id:regex}\"}[2m]) / (irate(redis_keyspace_misses_total{account=~\"${account:regex}\",group=~\"${group:regex}\", cluster_id=~\"${cluster_id:regex}\"}[1m]) + irate(redis_keyspace_hits_total{account=~\"${account:regex}\",group=~\"${group:regex}\", cluster_id=~\"${cluster_id:regex}\"}[2m]))) by (instance)",
            "legend": "__auto"
          },
          {
            "id": "H",
            "expression": "sum (redis_db_keys{account=~\"${account:regex}\",group=~\"${group:regex}\", cluster_id=~\"${cluster_id:regex}\"}) by (instance)",
            "legend": "__auto"
          },
          {
            "id": "I",
            "expression": "sum(irate(redis_net_input_bytes_total{account=~\"${account:regex}\",group=~\"${group:regex}\", cluster_id=~\"${cluster_id:regex}\"}[2m])) by (instance)",
            "legend": "__auto"
          },
          {
            "id": "J",
            "expression": "sum(irate(redis_net_output_bytes_total{account=~\"${account:regex}\",group=~\"${group:regex}\", cluster_id=~\"${cluster_id:regex}\"}[2m])) by (instance)",
            "legend": "__auto"
          }
        ]
      },
      "display": {
        "unit": "",
        "unitPreset": "",
        "autoScale": false,
        "decimals": 2,
        "emptyText": "",
        "errorText": "",
        "tableColumns": [
          {
            "name": "name",
            "label": "名称"
          },
          {
            "name": "ver",
            "label": "版本"
          },
          {
            "name": "mem",
            "label": "总内存"
          },
          {
            "name": "Value #B",
            "label": "CPU%"
          },
          {
            "name": "Value #C",
            "label": "内存%"
          },
          {
            "name": "Value #G",
            "label": "命中率"
          },
          {
            "name": "Value #D",
            "label": "连接数"
          },
          {
            "name": "Value #E",
            "label": "操作数/s"
          },
          {
            "name": "Value #I",
            "label": "流入"
          },
          {
            "name": "Value #J",
            "label": "流出"
          },
          {
            "name": "Value #H",
            "label": "总Keys"
          },
          {
            "name": "Value #F",
            "label": "启动"
          },
          {
            "name": "exp",
            "label": "到期日"
          },
          {
            "name": "itype",
            "label": "类型"
          },
          {
            "name": "iid",
            "label": "实例ID"
          },
          {
            "name": "Value #K",
            "label": "IOPS"
          },
          {
            "name": "cpu",
            "label": "总CPU"
          },
          {
            "name": "disk",
            "label": "总磁盘"
          }
        ],
        "tableHiddenColumns": [
          "Value #A",
          "__name__",
          "account",
          "group",
          "iaccount",
          "igroup",
          "iname",
          "instance",
          "job",
          "origin_prometheus",
          "region",
          "vendor"
        ],
        "showValueColumn": false
      }
    },
