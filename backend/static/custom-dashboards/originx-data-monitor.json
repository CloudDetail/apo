        "presetId": "",
        "expression": "sum(increase(originx_sr_adapter_apmtrace_count{is_hit=\"true\", cluster_id=~\"${cluster_id:regex}\"}[$interval]))",
        "params": {},
        "legend": "匹配",
        "queries": [
          {
            "id": "A",
            "expression": "sum(increase(originx_sr_adapter_apmtrace_count{is_hit=\"true\", cluster_id=~\"${cluster_id:regex}\"}[$interval]))",
            "legend": "匹配"
