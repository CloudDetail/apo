      "query": {
        "mode": "custom",
        "presetId": "",
        "expression": "1/2^otelcol_processor_back_sampling_sample_value{node_name=~\"${node_name:regex}\", cluster_id=~\"${cluster_id:regex}\"}",
        "params": {},
        "legend": "{{node_name}}",
        "queries": [
          {
            "id": "A",
            "expression": "1/2^otelcol_processor_back_sampling_sample_value{node_name=~\"${node_name:regex}\", cluster_id=~\"${cluster_id:regex}\"}",
            "legend": "{{node_name}}"
