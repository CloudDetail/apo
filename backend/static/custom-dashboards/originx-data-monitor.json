      }
    },
    {
      "id": "grafana-11",
      "title": "采样Span数",
      "description": "采样Span数。",
      "type": "line",
      "layout": {
        "x": 0,
        "y": 5,
        "w": 2,
        "h": 1
      },
      "query": {
        "mode": "custom",
        "presetId": "",
        "expression": "sum by (sample) (increase(otelcol_processor_back_sampling_span_count{node_name=~\"${node_name:regex}\", cluster_id=~\"${cluster_id:regex}\"}[$interval]))",
        "params": {},
