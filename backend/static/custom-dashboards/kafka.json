{
  "id": "",
  "name": "Kafka 指标",
  "description": "从 Grafana 面板迁移并汉化，已转换为“我的面板”原生格式。来源：kafka。",
  "ownerId": 0,
  "creator": "",
  "visibility": "everyone",
  "teamIds": [],
  "variables": [
    {
      "name": "cluster_id",
      "label": "集群",
      "type": "cluster",
      "value": ".*",
      "multi": true,
      "required": false,
      "defaultValue": ".*",
      "includeAll": true,
      "allValue": ".*",
      "query": "SELECT DISTINCT scope_id AS __value, \nCASE \n  WHEN c.name != '' THEN c.name\n  ELSE scope_id\nEND AS __text\nFROM data_scope \nLEFT JOIN clusters c ON scope_id  = c.id\nWHERE type = 'cluster'",
      "labels": [
        "cluster",
        "cluster_id",
        "clusterId",
        "clusterID",
        "cluster_name"
      ]
    },
    {
      "name": "job",
      "label": "采集任务",
      "type": "label",
      "value": "None",
      "multi": false,
      "required": false,
      "defaultValue": "None",
      "query": "label_values(kafka_brokers,job)",
      "labels": [
        "job"
      ]
    },
    {
      "name": "name",
      "label": "名称",
      "type": "label",
      "value": "None",
      "multi": false,
      "required": false,
      "defaultValue": "None",
      "query": "label_values(kafka_brokers{job=~\"$job\", cluster_id=~\"$cluster_id\"},name)",
      "labels": [
        "name"
      ]
    },
    {
      "name": "consumer_group",
      "label": "消费组",
      "type": "label",
      "value": ".*",
      "multi": false,
      "required": false,
      "defaultValue": ".*",
      "includeAll": true,
      "allValue": ".*",
      "query": "query_result(count by (consumergroup)(kafka_consumergroup_members{job=\"$job\",name=~\"$name\",consumergroup!~\"__.*\", cluster_id=~\"$cluster_id\"}))",
      "labels": [
        "consumergroup"
      ]
    },
    {
      "name": "topic",
      "label": "主题",
      "type": "label",
      "value": ".*",
      "multi": false,
      "required": false,
      "defaultValue": ".*",
      "includeAll": true,
      "allValue": ".*",
      "query": "label_values(kafka_consumergroup_lag_sum{job=\"$job\",name=~\"$name\",topic !~\"__.*\",consumergroup=~\"$consumer_group\", cluster_id=~\"$cluster_id\"},topic)",
      "labels": [
        "topic"
      ]
    },
    {
      "name": "consumergroup_hide",
      "label": "消费组过滤",
      "type": "label",
      "value": ".*",
      "multi": false,
      "required": false,
      "defaultValue": ".*",
      "includeAll": true,
      "allValue": ".*",
      "query": "label_values(kafka_consumergroup_lag_sum{job=\"$job\", name=~\"$name\", topic!~\"__.*\", topic=~\"$topic\", consumergroup!~\"__.*\", cluster_id=~\"$cluster_id\"},consumergroup)",
      "labels": [
        "consumergroup"
      ]
    }
  ],
