      "query": {
        "mode": "custom",
        "presetId": "",
        "expression": "sum(rate(node_network_receive_drop_total{ job_name=\"$job_name\", cluster_id=~\"${cluster_id:regex}\"}[$__rate_interval]))",
        "params": {},
        "legend": "Linux Packets dropped (接收)",
        "queries": [
          {
            "id": "Linux Packets dropped (receive)",
            "expression": "sum(rate(node_network_receive_drop_total{ job_name=\"$job_name\", cluster_id=~\"${cluster_id:regex}\"}[$__rate_interval]))",
            "legend": "Linux Packets dropped (接收)"
          },
          {
            "id": "Linux Packets dropped (transmit)",
            "expression": "- sum(rate(node_network_transmit_drop_total{ job_name=\"$job_name\", cluster_id=~\"${cluster_id:regex}\"}[$__rate_interval]))",
            "legend": "Linux Packets dropped (发送)"
          },
          {
            "id": "Windows Packets dropped (receive)",
            "expression": "sum(rate(windows_net_packets_received_discarded_total{ job_name=\"$job_name\", cluster_id=~\"${cluster_id:regex}\"}[$__rate_interval]))",
            "legend": "Windows Packets dropped (接收)"
          },
          {
            "id": "Windows Packets dropped (transmit)",
            "expression": "- sum(rate(windows_net_packets_outbound_discarded_total{ job_name=\"$job_name\", cluster_id=~\"${cluster_id:regex}\"}[$__rate_interval]))",
            "legend": "Windows Packets dropped (发送)"
          }
        ]
      },
      "display": {
        "unit": "",
        "unitPreset": "",
        "autoScale": false,
        "decimals": 2,
        "emptyText": "",
        "errorText": "",
        "warningThreshold": 80.0
