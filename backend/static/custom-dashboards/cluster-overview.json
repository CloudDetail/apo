    {
      "id": "grafana-44",
      "title": "集群整体网络带宽(按设备统计)",
      "description": "集群整体网络带宽(按设备统计)。",
      "type": "line",
      "layout": {
        "x": 0,
        "y": 5,
        "w": 2,
        "h": 1
      },
      "query": {
        "mode": "custom",
        "presetId": "",
        "expression": "sum(rate(node_network_receive_bytes_total{device!~\"(veth|azv|lxc|cali).*\",  job_name=\"$job_name\", cluster_id=~\"${cluster_id:regex}\"}[$__rate_interval])) by (device)",
        "params": {},
        "legend": "接收 : {{ device }}",
        "queries": [
          {
            "id": "Linux Received",
            "expression": "sum(rate(node_network_receive_bytes_total{device!~\"(veth|azv|lxc|cali).*\",  job_name=\"$job_name\", cluster_id=~\"${cluster_id:regex}\"}[$__rate_interval])) by (device)",
            "legend": "接收 : {{ device }}"
          },
          {
            "id": "Linux Transmitted",
            "expression": "- sum(rate(node_network_transmit_bytes_total{device!~\"(veth|azv|lxc|cali).*\",  job_name=\"$job_name\", cluster_id=~\"${cluster_id:regex}\"}[$__rate_interval])) by (device)",
            "legend": "发送 : {{ device }}"
          },
          {
            "id": "Windows Received",
            "expression": "sum(rate(windows_net_bytes_received_total{ job_name=\"$job_name\", cluster_id=~\"${cluster_id:regex}\"}[$__rate_interval])) by (nic)",
            "legend": "接收 : {{ nic }}"
          },
          {
            "id": "Windows Transmitted",
            "expression": "- sum(rate(windows_net_bytes_sent_total{ job_name=\"$job_name\", cluster_id=~\"${cluster_id:regex}\"}[$__rate_interval])) by (nic)",
            "legend": "发送 : {{ device }}"
          }
        ]
      },
      "display": {
        "unit": "B",
        "unitPreset": "bytes",
        "autoScale": true,
        "decimals": 2,
        "emptyText": "",
        "errorText": "",
        "warningThreshold": 80.0
      }
    },
    {
