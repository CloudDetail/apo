{
  "id": "",
  "name": "集群总览",
  "description": "从 Grafana 面板迁移并汉化，已转换为“我的面板”原生格式。来源：cluster-overview。",
  "ownerId": 0,
  "creator": "",
  "visibility": "everyone",
  "teamIds": [],
  "variables": [
    {
      "name": "cluster_id",
      "label": "集群",
      "type": "cluster",
      "value": ".*",
      "multi": true,
      "required": false,
      "defaultValue": ".*",
      "includeAll": true,
      "allValue": ".*",
      "query": "SELECT DISTINCT scope_id AS __value, \nCASE \n  WHEN c.name != '' THEN c.name\n  ELSE scope_id\nEND AS __text\nFROM data_scope \nLEFT JOIN clusters c ON scope_id  = c.id\nWHERE type = 'cluster'",
      "labels": [
        "cluster",
        "cluster_id",
        "clusterId",
        "clusterID",
        "cluster_name"
      ]
    },
    {
      "name": "resolution",
      "label": "精度",
      "type": "custom",
      "value": "1m",
      "multi": false,
      "required": false,
      "defaultValue": "1m",
      "options": [
        {
          "label": "1s",
          "value": "1s"
        },
        {
          "label": "15s",
          "value": "15s"
        },
        {
          "label": "30s",
          "value": "30s"
        },
        {
          "label": "1m",
          "value": "1m"
        },
        {
          "label": "3m",
          "value": "3m"
        },
        {
          "label": "5m",
          "value": "5m"
        }
      ],
      "query": "1s, 15s, 30s, 1m, 3m, 5m"
    },
    {
      "name": "job_name",
      "label": "采集任务",
      "type": "label",
      "value": "",
      "multi": false,
      "required": false,
      "defaultValue": "",
      "query": "label_values(node_cpu_seconds_total{ cluster_id=~\"$cluster_id\"},job_name)",
      "labels": [
        "job_name"
      ]
    },
    {
      "name": "cadvisor_job_name",
      "label": "容器采集任务",
      "type": "label",
      "value": "",
      "multi": false,
      "required": false,
      "defaultValue": "",
      "query": "label_values(container_cpu_usage_seconds_total,job_name)",
      "labels": [
        "job_name"
      ]
    }
  ],
  "widgets": [
    {
      "id": "grafana-77",
      "title": "集群总CPU使用率",
      "description": "集群总CPU使用率。",
      "type": "barGauge",
      "layout": {
        "x": 0,
        "y": 0,
        "w": 1,
        "h": 1
      },
      "query": {
        "mode": "custom",
        "presetId": "",
        "expression": "avg(sum by (instance_name, cpu) (rate(node_cpu_seconds_total{mode!~\"idle|iowait|steal\",  job_name=\"$job_name\", cluster_id=~\"${cluster_id:regex}\"}[$__rate_interval])))",
        "params": {},
        "legend": "Real Linux",
        "queries": [
          {
            "id": "Real Linux",
            "expression": "avg(sum by (instance_name, cpu) (rate(node_cpu_seconds_total{mode!~\"idle|iowait|steal\",  job_name=\"$job_name\", cluster_id=~\"${cluster_id:regex}\"}[$__rate_interval])))",
            "legend": "Real Linux"
          }
        ]
      },
      "display": {
        "unit": "%",
        "unitPreset": "percent",
        "autoScale": true,
        "decimals": 2,
        "emptyText": "",
        "errorText": "",
        "warningThreshold": 80.0
      }
    },
    {
      "id": "grafana-78",
      "title": "集群总内存使用率",
      "description": "集群总内存使用率。",
      "type": "barGauge",
      "layout": {
        "x": 1,
        "y": 0,
        "w": 2,
        "h": 1
      },
      "query": {
        "mode": "custom",
        "presetId": "",
        "expression": "sum(node_memory_MemTotal_bytes{ job_name=\"$job_name\", cluster_id=~\"${cluster_id:regex}\"} - node_memory_MemAvailable_bytes{ job_name=\"$job_name\", cluster_id=~\"${cluster_id:regex}\"}) / sum(max_over_time(node_memory_MemTotal_bytes{ job_name=\"$job_name\", cluster_id=~\"${cluster_id:regex}\"}[5m]))",
        "params": {},
        "legend": "Real Linux",
        "queries": [
          {
            "id": "Real Linux",
            "expression": "sum(node_memory_MemTotal_bytes{ job_name=\"$job_name\", cluster_id=~\"${cluster_id:regex}\"} - node_memory_MemAvailable_bytes{ job_name=\"$job_name\", cluster_id=~\"${cluster_id:regex}\"}) / sum(max_over_time(node_memory_MemTotal_bytes{ job_name=\"$job_name\", cluster_id=~\"${cluster_id:regex}\"}[5m]))",
            "legend": "Real Linux"
          }
        ]
      },
      "display": {
        "unit": "%",
        "unitPreset": "percent",
        "autoScale": true,
        "decimals": 2,
        "emptyText": "",
        "errorText": "",
        "warningThreshold": 80.0
      }
    },
