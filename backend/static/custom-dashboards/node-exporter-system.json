      "type": "line",
      "layout": {
        "x": 0,
        "y": 2,
        "w": 2,
        "h": 1
      },
      "query": {
        "mode": "custom",
        "presetId": "",
        "expression": "node_timex_sync_status{instance_name=\"$node\",job_name=\"$job\", cluster_id=~\"${cluster_id:regex}\"}",
        "params": {},
        "legend": "Is clock synchronized to a reliable server (1 = yes, 0 = no)",
        "queries": [
          {
            "id": "A",
            "expression": "node_timex_sync_status{instance_name=\"$node\",job_name=\"$job\", cluster_id=~\"${cluster_id:regex}\"}",
            "legend": "Is clock synchronized to a reliable server (1 = yes, 0 = no)"
          },
          {
            "id": "B",
