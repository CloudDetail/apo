{
  "id": "",
  "name": "宿主机监控指标 - 系统与硬件",
  "description": "从 Grafana 面板迁移并汉化，已转换为“我的面板”原生格式。来源：node-exporter-system。",
  "ownerId": 0,
  "creator": "",
  "visibility": "everyone",
  "teamIds": [],
  "variables": [
    {
      "name": "cluster_id",
      "label": "集群",
      "type": "cluster",
      "value": ".*",
      "multi": true,
      "required": false,
      "defaultValue": ".*",
      "includeAll": true,
      "allValue": ".*",
      "query": "SELECT DISTINCT scope_id AS __value, \nCASE \n  WHEN c.name != '' THEN c.name\n  ELSE scope_id\nEND AS __text\nFROM data_scope \nLEFT JOIN clusters c ON scope_id  = c.id\nWHERE type = 'cluster'",
      "labels": [
        "cluster",
        "cluster_id",
        "clusterId",
        "clusterID",
        "cluster_name"
      ]
    },
    {
      "name": "job",
      "label": "采集任务",
      "type": "label",
      "value": "",
      "multi": false,
      "required": false,
      "defaultValue": "",
      "query": "label_values(node_uname_info,job_name)",
      "labels": [
        "job_name"
      ]
    },
    {
      "name": "node",
      "label": "主机",
      "type": "label",
      "value": "",
      "multi": false,
      "required": false,
      "defaultValue": "",
      "query": "label_values(node_uname_info{job_name=\"$job\", cluster_id=~\"$cluster_id\"},instance_name)",
      "labels": [
        "instance_name"
      ]
    },
    {
      "name": "diskdevices",
      "label": "磁盘设备",
      "type": "custom",
      "value": "[a-z]+|nvme[0-9]+n[0-9]+|mmcblk[0-9]+",
      "multi": false,
      "required": false,
      "defaultValue": "[a-z]+|nvme[0-9]+n[0-9]+|mmcblk[0-9]+",
      "options": [
        {
          "label": "[a-z]+|nvme[0-9]+n[0-9]+|mmcblk[0-9]+",
          "value": "[a-z]+|nvme[0-9]+n[0-9]+|mmcblk[0-9]+"
        }
      ],
      "query": "[a-z]+|nvme[0-9]+n[0-9]+|mmcblk[0-9]+"
    }
  ],
  "widgets": [
    {
      "id": "grafana-260",
      "title": "时间同步偏差",
      "description": "宿主机与参考时钟的时间偏移(秒)；宿主机时间同步最大误差(秒)",
      "type": "line",
      "layout": {
        "x": 0,
        "y": 0,
        "w": 2,
        "h": 1
      },
      "query": {
        "mode": "custom",
        "presetId": "",
        "expression": "node_timex_estimated_error_seconds{instance_name=\"$node\",job_name=\"$job\", cluster_id=~\"${cluster_id:regex}\"}",
        "params": {},
        "legend": "Estimated 错误 in seconds",
        "queries": [
          {
            "id": "A",
            "expression": "node_timex_estimated_error_seconds{instance_name=\"$node\",job_name=\"$job\", cluster_id=~\"${cluster_id:regex}\"}",
            "legend": "Estimated 错误 in seconds"
          },
          {
            "id": "B",
            "expression": "node_timex_offset_seconds{instance_name=\"$node\",job_name=\"$job\", cluster_id=~\"${cluster_id:regex}\"}",
            "legend": "Time offset in between local system and reference clock"
          },
          {
            "id": "C",
            "expression": "node_timex_maxerror_seconds{instance_name=\"$node\",job_name=\"$job\", cluster_id=~\"${cluster_id:regex}\"}",
            "legend": "Maximum 错误 in seconds"
          }
        ]
      },
      "display": {
        "unit": "s",
        "unitPreset": "seconds",
        "autoScale": false,
        "decimals": 2,
        "emptyText": "",
        "errorText": "",
        "warningThreshold": 80.0
      }
    },
    {
      "id": "grafana-291",
      "title": "时间锁相环调整",
      "description": "宿主机时间锁相环调整值",
      "type": "line",
      "layout": {
        "x": 2,
        "y": 0,
        "w": 2,
        "h": 1
      },
      "query": {
        "mode": "custom",
        "presetId": "",
        "expression": "node_timex_loop_time_constant{instance_name=\"$node\",job_name=\"$job\", cluster_id=~\"${cluster_id:regex}\"}",
        "params": {},
        "legend": "Phase-locked loop time adjust",
        "queries": [
          {
            "id": "A",
            "expression": "node_timex_loop_time_constant{instance_name=\"$node\",job_name=\"$job\", cluster_id=~\"${cluster_id:regex}\"}",
            "legend": "Phase-locked loop time adjust"
          }
        ]
