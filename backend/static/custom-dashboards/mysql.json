{
  "id": "",
  "name": "MySQL 指标",
  "description": "从 Grafana 面板迁移并汉化，已转换为“我的面板”原生格式。来源：mysql。",
  "ownerId": 0,
  "creator": "",
  "visibility": "everyone",
  "teamIds": [],
  "variables": [
    {
      "name": "cluster_id",
      "label": "集群",
      "type": "cluster",
      "value": ".*",
      "multi": true,
      "required": false,
      "defaultValue": ".*",
      "includeAll": true,
      "allValue": ".*",
      "query": "SELECT DISTINCT scope_id AS __value, \nCASE \n  WHEN c.name != '' THEN c.name\n  ELSE scope_id\nEND AS __text\nFROM data_scope \nLEFT JOIN clusters c ON scope_id  = c.id\nWHERE type = 'cluster'",
      "labels": [
        "cluster",
        "cluster_id",
        "clusterId",
        "clusterID",
        "cluster_name"
      ]
    },
    {
      "name": "job",
      "label": "采集任务",
      "type": "label",
      "value": ".*",
      "multi": true,
      "required": false,
      "defaultValue": ".*",
      "includeAll": true,
      "allValue": ".*",
      "query": "label_values(mysql_up, job)",
      "labels": [
        "job"
      ]
    },
    {
      "name": "instance",
      "label": "实例",
      "type": "instance",
      "value": ".*",
      "multi": true,
      "required": false,
      "defaultValue": ".*",
      "includeAll": true,
      "allValue": ".*",
      "query": "label_values(mysql_up{cluster_id=~\"$cluster_id\"}, instance)",
      "labels": [
        "instance",
        "instance_name",
        "node_name",
        "nodeName",
        "host_name",
        "hostName"
      ]
    }
  ],
  "widgets": [
    {
      "id": "grafana-12",
      "title": "运行时间",
      "description": "运行时间。",
      "type": "stat",
      "layout": {
        "x": 0,
        "y": 0,
        "w": 1,
        "h": 1
      },
      "query": {
        "mode": "custom",
        "presetId": "",
        "expression": "mysql_global_status_uptime{job=~\"${job:regex}\", instance=~\"${instance:regex}\"}",
        "params": {},
        "legend": "{{instance}}",
        "queries": [
          {
            "id": "A",
            "expression": "mysql_global_status_uptime{job=~\"${job:regex}\", instance=~\"${instance:regex}\"}",
            "legend": "{{instance}}"
          }
        ]
      },
      "display": {
        "unit": "s",
        "unitPreset": "seconds",
        "autoScale": false,
        "decimals": 1,
        "emptyText": "",
        "errorText": "",
        "warningThreshold": 300.0,
        "criticalThreshold": 3600.0
      }
    },
    {
      "id": "grafana-13",
      "title": "每秒查询数",
      "description": "每秒查询数。",
      "type": "stat",
      "layout": {
        "x": 1,
        "y": 0,
        "w": 1,
        "h": 1
      },
      "query": {
        "mode": "custom",
        "presetId": "",
        "expression": "rate(mysql_global_status_queries{job=~\"${job:regex}\", instance=~\"${instance:regex}\"}[$__interval])",
        "params": {},
        "legend": "{{instance}}",
        "queries": [
          {
            "id": "A",
            "expression": "rate(mysql_global_status_queries{job=~\"${job:regex}\", instance=~\"${instance:regex}\"}[$__interval])",
            "legend": "{{instance}}"
          }
        ]
      },
      "display": {
        "unit": "short",
        "unitPreset": "custom",
        "autoScale": false,
        "decimals": 2,
        "emptyText": "",
        "errorText": "",
        "warningThreshold": 35.0,
        "criticalThreshold": 75.0
      }
    },
    {
