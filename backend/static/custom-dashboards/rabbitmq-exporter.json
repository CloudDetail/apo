      "query": {
        "mode": "custom",
        "presetId": "",
        "expression": "rabbitmq_up{instance=~\"$instance.*\", cluster_id=~\"${cluster_id:regex}\"}",
        "params": {},
        "legend": "",
        "queries": [
          {
            "id": "A",
            "expression": "rabbitmq_up{instance=~\"$instance.*\", cluster_id=~\"${cluster_id:regex}\"}",
            "legend": ""
