{
  "id": "",
  "name": "RabbitMQ Exporter 指标",
  "description": "从 Grafana 面板迁移并汉化，已转换为“我的面板”原生格式。来源：rabbitmq-exporter。",
  "ownerId": 0,
  "creator": "",
  "visibility": "everyone",
  "teamIds": [],
  "variables": [
    {
      "name": "cluster_id",
      "label": "集群",
      "type": "cluster",
      "value": ".*",
      "multi": true,
      "required": false,
      "defaultValue": ".*",
      "includeAll": true,
      "allValue": ".*",
      "query": "SELECT DISTINCT scope_id AS __value, \nCASE \n  WHEN c.name != '' THEN c.name\n  ELSE scope_id\nEND AS __text\nFROM data_scope \nLEFT JOIN clusters c ON scope_id  = c.id\nWHERE type = 'cluster'",
      "labels": [
        "cluster",
        "cluster_id",
        "clusterId",
        "clusterID",
        "cluster_name"
      ]
    },
    {
      "name": "instance",
      "label": "实例",
      "type": "instance",
      "value": ".*",
      "multi": true,
      "required": false,
      "defaultValue": ".*",
      "includeAll": true,
      "allValue": ".*",
      "query": "label_values(rabbitmq_up{cluster_id=~\"$cluster_id\"}, instance)",
      "labels": [
        "instance",
        "instance_name",
        "node_name",
        "nodeName",
        "host_name",
        "hostName"
      ]
    }
  ],
  "widgets": [
